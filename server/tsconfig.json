{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "paths": {
      "@verser/shared": ["../packages/shared/src"],
      "@verser/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "dist", "coverage"]
}
