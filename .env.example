# ════════════════════════════════════════════════════════════
# Verser — Environment Variables Template
# Copy to .env and fill with real values. Never commit .env.
# ════════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=file:./dev.db

# JWT — generate strong secrets (min 256 bits): `openssl rand -base64 64`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-256-bits
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-min-256-bits
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Abacus AI — leave ABACUS_AI_API_KEY empty to auto-use MockAIProvider in dev.
ABACUS_AI_API_KEY=
ABACUS_AI_BASE_URL=https://api.abacus.ai
ABACUS_AI_TEXT_MODEL=your-text-deployment-id
ABACUS_AI_IMAGE_MODEL=your-image-deployment-id

# Endpoint paths — adjust to match your Abacus product.
#   ChatLLM:          /v0/getChatResponse
#   OpenAI-compatible: /v1/chat/completions
#   Custom REST:      /v0/predict (or whatever your deployment exposes)
ABACUS_AI_TEXT_PATH=/v0/getChatResponse
ABACUS_AI_IMAGE_PATH=/v0/generateImage

# Auth style for the Abacus REST call.
#   bearer  -> Authorization: Bearer <ABACUS_AI_API_KEY>   (default; OpenAI-style)
#   header  -> apiKey: <ABACUS_AI_API_KEY>                 (Abacus REST classic)
#   body    -> caller embeds the token inside the JSON body (advanced)
ABACUS_AI_AUTH_STYLE=bearer

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Logging
LOG_LEVEL=info
