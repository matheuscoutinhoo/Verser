# ════════════════════════════════════════════════════════════
# Verser — Environment Variables Template
# Copy to .env and fill with real values. Never commit .env.
# ════════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=file:./dev.db

# JWT — generate strong secrets (min 256 bits): `openssl rand -base64 64`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-256-bits
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-min-256-bits
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Abacus AI — leave ABACUS_AI_API_KEY empty to auto-use MockAIProvider in dev.
ABACUS_AI_API_KEY=
ABACUS_AI_BASE_URL=https://api.abacus.ai
ABACUS_AI_TEXT_MODEL=your-text-deployment-id
# Image model — when ABACUS_AI_IMAGE_PATH points at /chat/completions, the
# server sends `{ messages, modalities: ['image'] }` and expects the response
# to embed `image_url` parts. Known multimodal models for RouteLLM:
#   - nano_banana_pro
#   - gemini-2.5-flash-image
ABACUS_AI_IMAGE_MODEL=nano_banana_pro

# Endpoint paths — adjust to match your Abacus product. The provider auto
# detects the request body shape from the path (chat/completions vs.
# images/generations vs. classic ChatLLM), so just point at the right one.
#
#   Text:
#     ChatLLM (classic):       /v0/getChatResponse
#     OpenAI-compatible chat:  /v1/chat/completions
#     RouteLLM:                https://routellm.abacus.ai/v1/chat/completions
#
#   Image:
#     ChatLLM (classic):       /v0/generateImage         (REST predict on an image deployment)
#     OpenAI-compatible chat:  /v1/chat/completions      (multimodal models like Gemini Flash Image)
#     OpenAI-compatible image: /v1/images/generations    (DALL-E-style endpoints)
ABACUS_AI_TEXT_PATH=/v0/getChatResponse
ABACUS_AI_IMAGE_PATH=/v0/generateImage

# Auth style for the Abacus REST call.
#   bearer  -> Authorization: Bearer <ABACUS_AI_API_KEY>   (default; OpenAI-style)
#   header  -> apiKey: <ABACUS_AI_API_KEY>                 (Abacus REST classic)
#   body    -> caller embeds the token inside the JSON body (advanced)
ABACUS_AI_AUTH_STYLE=bearer

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Logging
LOG_LEVEL=info
