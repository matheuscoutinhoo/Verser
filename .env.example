# ════════════════════════════════════════════════════════════
# Verser — Environment Variables Template
# Copy to .env and fill with real values. Never commit .env.
# ════════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=file:./dev.db

# JWT — generate strong secrets (min 256 bits): `openssl rand -base64 64`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-256-bits
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-min-256-bits
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Abacus AI
ABACUS_AI_API_KEY=your-abacus-ai-api-key
ABACUS_AI_TEXT_MODEL=abacus-default-text
ABACUS_AI_IMAGE_MODEL=abacus-default-image
ABACUS_AI_BASE_URL=https://api.abacus.ai

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Logging
LOG_LEVEL=info
